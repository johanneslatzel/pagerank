{
    "name": "@johannes.latzel/pagerank",
    "version": "1.0.3",
    "description": "Zero-dependency, ESM-native weighted PageRank implementation for TypeScript",
    "license": "MIT",
    "author": "Johannes B. Latzel",
    "files": [
        "dist/",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "prebuild": "rm -rf -- dist",
        "build": "tsc -p tsconfig.build.json",
        "verify": "tsc --noEmit && eslint . --max-warnings 0 && vitest run --coverage",
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write src",
        "test": "vitest",
        "test:coverage": "vitest run --coverage",
        "clean:pack": "rm -rf node_modules dist/ package-lock.json && npm cache clean --force && npm install && npm run verify && npm run build && npm pack",
        "clean:install": "rm -rf node_modules dist/ package-lock.json && npm cache clean --force && npm install && npm run verify",
        "docs": "docker run --rm -it -p 8000:8000 -v $PWD:/docs squidfunk/mkdocs-material",
        "prepare": "husky",
        "audit": "npm audit --audit-level=high"
    },
    "lint-staged": {
        "src/**/*.ts": [
            "prettier --write",
            "eslint --max-warnings 0 --no-warn-ignored",
            "vitest related --run"
        ]
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@typescript-eslint/eslint-plugin": "^8.60.0",
        "@typescript-eslint/parser": "^8.60.0",
        "@vitest/coverage-v8": "^4.1.9",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.2",
        "eslint-plugin-n": "^18.2.2",
        "prettier": "^3.5.3",
        "typescript": "^7.0.2",
        "vitest": "^4.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/johanneslatzel/pagerank.git"
    },
    "bugs": {
        "url": "https://github.com/johanneslatzel/pagerank/issues"
    },
    "homepage": "https://github.com/johanneslatzel/pagerank#readme",
    "keywords": [
        "pagerank",
        "graph",
        "ranking",
        "link-analysis",
        "typescript"
    ]
}
